# Sao chép file này thành `.env` (cùng thư mục với README.md) rồi điền giá trị thật:
#     Windows PowerShell:  copy .env.example .env
#     macOS / Linux:       cp .env.example .env
# KHÔNG đưa file .env lên GitHub và KHÔNG gửi cho người khác.

# BẮT BUỘC để tải dữ liệu: khoá FRED API, gồm 32 ký tự chữ thường và số.
# Đăng ký miễn phí: https://fred.stlouisfed.org/  ->  My Account  ->  API Keys  ->  Request API Key
FRED_API_KEY=your_key_here

# TUỲ CHỌN: nếu mạng của bạn bắt buộc đi qua proxy, bỏ dấu # ở hai dòng dưới và điền địa chỉ proxy.
# HTTPS_PROXY=http://user:password@proxy-host:port
# HTTP_PROXY=http://user:password@proxy-host:port
